POLICY_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_BASE_URL=https://your-codex-endpoint.example/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional explicit interpreter; otherwise use the caller/container PATH.
PYTHON=
VLLM_COMMAND=
DOMAIN=who_when
# Optional explicit file override; normally DOMAIN selects configs/<domain>.yaml.
CONFIG=
BACKEND=codex
BASE_MODEL_NAME=Qwen3.5-9B
# Leave unset to use model.base from the selected domain config. Set this only to
# explicitly override the configured local path or Hugging Face model ID.
MODEL_PATH=
POLICY_MODEL=Qwen3.5-9B
# Leave empty to use the round/rollback limits from YAML.
ROUNDS=
POLICY_ROLLBACK_PATIENCE=
MAX_HARNESS_ATTEMPTS=
ATTEMPTS_PER_ITEM=
MAX_TURNS=
TRAIN_DATA=
REBUILD_SPLITS=0
# Leave CUDA_VISIBLE_DEVICES unset to use every GPU visible to the process.
# Set it only when a scheduler has not already restricted the allocation.
# CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
TENSOR_PARALLEL_SIZE=
# Leave these empty to derive them from the visible GPU count.
DATA_PARALLEL_SIZE=
TRAINING_NUM_PROCESSES=
GPU_MEMORY_UTILIZATION=
MAX_MODEL_LEN=
TRAINING_MAX_LENGTH=
# Empty resource/rollout settings use the selected domain YAML.
TRAINING_SEQUENCE_PARALLEL_SIZE=
SAMPLING_CONCURRENCY=
INFERENCE_CONCURRENCY=
SAMPLING_QUALITY_TIER=
COEVOX_COLOR=1
WHO_AND_WHEN_ROOT="../who_and_when/Who&When"
